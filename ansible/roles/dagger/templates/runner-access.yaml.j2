
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: dagger-engine-client
  namespace: "{{ dagger.namespace }}"
rules:
  - apiGroups: [""]
    resources:
      - pods
    verbs:
      - get
      - list

  - apiGroups: [""]
    resources:
      - pods/exec
      - pods/portforward
    verbs:
      - create

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: dagger-engine-client
  namespace: "{{ dagger.namespace }}"
subjects:
  - kind: ServiceAccount
    name: default
    namespace: "{{ forgejo_runner.namespace }}"
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: dagger-engine-client
